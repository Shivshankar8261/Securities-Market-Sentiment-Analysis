# Copy this file to .env and put your own API keys in it (never commit / submit real keys).
# Groq API (default engine when set) - https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Google Gemini API (automatic fallback when Groq fails) - https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# SMSA_GEMINI_MODEL=gemini-3.5-flash
# SMSA_FALLBACK=1                 # 0 disables the automatic fallback chain
# Optional overrides
# SMSA_DEFAULT_ENGINE=groq        # groq | gemini | llm | finbert  (use llm for fully offline demos)
# SMSA_GROQ_MODEL=openai/gpt-oss-120b
